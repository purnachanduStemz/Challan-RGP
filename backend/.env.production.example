NODE_ENV=production
PORT=4000
TRUST_PROXY=true
DATABASE_URL=postgresql://challan_app:REPLACE_WITH_SECRET@DB_HOSTNAME:5432/challan_db?sslmode=require
JWT_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=8h
FILE_TOKEN_EXPIRES_IN=900
ALLOWED_ORIGINS=https://gatepass.example.com
RUN_SCHEMA_GUARD=false
ORG_NAME=Replace with legal company name
ORG_GSTIN=Replace with company GSTIN
ORG_STATE=Replace with company state
ORG_STATE_CODE=00
APP_BASE_URL=https://gatepass.example.com
SMTP_HOST=REPLACE_WITH_APPROVED_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SECRET
SMTP_PASS=REPLACE_WITH_SECRET
MAIL_FROM=Gate Pass <no-reply@example.com>
GSOC_EMAILS=
LOCAL_SM_EMAILS=
REMINDER_ENABLED=true
REMINDER_CRON=0 9 * * *
REMINDER_INTERVAL_DAYS=1
ESCALATE_TO_GSOC_AFTER_DAYS=0
